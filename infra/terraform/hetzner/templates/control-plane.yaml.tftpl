#cloud-config
package_update: true
package_upgrade: true
packages: [curl, ca-certificates, fail2ban, unattended-upgrades]
write_files:
  - path: /etc/rancher/k3s/config.yaml
    permissions: "0600"
    content: |
      token: "${k3s_token}"
      node-ip: "${private_ip}"
      advertise-address: "${private_ip}"
      flannel-iface: enp7s0
      tls-san: ["${private_ip}"]
      # ingress-nginx and the Hetzner LB replace the bundled Traefik / ServiceLB
      disable: [traefik, servicelb]
      secrets-encryption: true
      write-kubeconfig-mode: "0600"
      protect-kernel-defaults: false
      kube-apiserver-arg:
        - "admission-control-config-file=/etc/rancher/k3s/psa.yaml"
      node-taint:
        - "node-role.kubernetes.io/control-plane=true:NoSchedule"
  - path: /etc/rancher/k3s/psa.yaml
    permissions: "0600"
    content: |
      apiVersion: apiserver.config.k8s.io/v1
      kind: AdmissionConfiguration
      plugins:
        - name: PodSecurity
          configuration:
            apiVersion: pod-security.admission.config.k8s.io/v1
            kind: PodSecurityConfiguration
            defaults: { enforce: baseline, audit: restricted, warn: restricted }
            exemptions: { namespaces: [kube-system] }
runcmd:
  - curl -sfL https://get.k3s.io | INSTALL_K3S_CHANNEL="${k3s_channel}" sh -s - server
  - systemctl enable --now fail2ban
