#cloud-config
package_update: true
package_upgrade: true
packages: [curl, ca-certificates, fail2ban, unattended-upgrades]
runcmd:
  - |
    # Wait until the private network interface has its address, then join the server.
    until ip -4 addr show enp7s0 | grep -q inet; do sleep 2; done
    NODE_IP="$(ip -4 -o addr show enp7s0 | awk '{print $4}' | cut -d/ -f1)"
    curl -sfL https://get.k3s.io | INSTALL_K3S_CHANNEL="${k3s_channel}" K3S_URL="${server_url}" K3S_TOKEN="${k3s_token}" \
      sh -s - agent --node-ip "$NODE_IP" --flannel-iface enp7s0
  - systemctl enable --now fail2ban
