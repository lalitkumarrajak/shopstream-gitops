# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
# export TF_VAR_hcloud_token=...                   (never put the token in a file in Git)
cluster_name       = "shopstream"
location           = "nbg1"
network_zone       = "eu-central"
control_plane_type = "cx23"
worker_type        = "cx33"
worker_count       = 2
ssh_public_key     = "ssh-ed25519 AAAA... you@laptop"
allowed_ssh_cidrs  = ["203.0.113.10/32"]
allowed_api_cidrs  = ["203.0.113.10/32"]
